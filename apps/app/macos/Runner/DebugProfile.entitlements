<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Без App Sandbox и без network.server (ADR-012): причины — в
     Release.entitlements. JIT нужен только отладочной сборке: hardened
     runtime запрещает исполняемую память, а Dart в Debug работает на JIT;
     в Release программа скомпилирована заранее. -->
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
