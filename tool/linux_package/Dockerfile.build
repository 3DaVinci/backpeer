# Образ сборки пакетов Linux (задача 5.7.3). Ubuntu 22.04 — самая старая
# система из docs/mvp-scope.md: собранное на ней работает и на новых
# (glibc и GTK совместимы вперёд, но не назад).
FROM ubuntu:24.04

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      clang cmake ninja-build pkg-config libgtk-3-dev liblzma-dev \
      libstdc++-12-dev gcc g++ make libc6-dev \
      git curl ca-certificates xz-utils unzip file \
      dpkg-dev fakeroot rpm gnupg desktop-file-utils appstream \
 && rm -rf /var/lib/apt/lists/*

# appimagetool (MIT) — версия и хэш закреплены, хэш сверен с GitHub.
ARG APPIMAGETOOL_VERSION=1.9.1
ARG APPIMAGETOOL_SHA256_X86_64=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0
ARG APPIMAGETOOL_SHA256_AARCH64=f0837e7448a0c1e4e650a93bb3e85802546e60654ef287576f46c71c126a9158
RUN arch="$(uname -m)" \
 && case "$arch" in \
      x86_64) sum="$APPIMAGETOOL_SHA256_X86_64" ;; \
      aarch64) sum="$APPIMAGETOOL_SHA256_AARCH64" ;; \
      *) echo "нет appimagetool для $arch" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /usr/local/bin/appimagetool \
      "https://github.com/AppImage/appimagetool/releases/download/${APPIMAGETOOL_VERSION}/appimagetool-${arch}.AppImage" \
 && echo "${sum}  /usr/local/bin/appimagetool" | sha256sum -c - \
 && chmod +x /usr/local/bin/appimagetool

# В контейнере нет FUSE: appimagetool распаковывает себя и запускается.
ENV APPIMAGE_EXTRACT_AND_RUN=1

# Сборка идёт от имени пользователя хоста (файлы в build/ — его).
RUN mkdir -m 1777 /src /out /work
